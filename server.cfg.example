# =============================================================
# LAND OF THE BLOODY RP — Core Build v0.3
# Custom LOTB resources are additive to a current Qbox deploy.
# =============================================================

sv_hostname "Land of the Bloody RP | Serious RP"
sets sv_projectName "Land of the Bloody RP"
sets sv_projectDesc "The city remembers. High-consequence serious roleplay."
sets tags "seriousrp,roleplay,qbox,lotb,whitelist"

set onesync on
set onesync_population true

# Keep secrets in your real server.cfg / environment, never in Git.
# set mysql_connection_string "mysql://USER:PASSWORD@HOST/DB?charset=utf8mb4"
# sv_licenseKey "YOUR_CFX_KEY"

# Do not hard-code an old game build here. Pick the build required by the
# current Qbox/FiveM resources you actually install and test.
# sv_enforceGameBuild <CURRENT_TESTED_BUILD>

# LOTB ACE permissions. Map your real admin/staff principals to these groups
# in the private production config, not in this public repository.
add_ace group.admin lotb.admin allow
add_ace group.admin lotb.justice.manage allow
add_ace group.admin lotb.business.manage allow
add_ace group.admin lotb.crew.manage allow
add_ace group.admin lotb.medical.manage allow

# Start the normal Qbox / ox dependencies BEFORE this block:
# qbx_core, ox_lib, oxmysql, ox_inventory, appearance, voice, phone, etc.

ensure lotb_core
ensure lotb_identity
ensure lotb_citymemory
ensure lotb_scenethreads
ensure lotb_evidence
ensure lotb_economy
ensure lotb_businesses
ensure lotb_crews
ensure lotb_contracts
ensure lotb_dispatch
ensure lotb_justice
ensure lotb_medical
ensure lotb_world
ensure lotb_rumors
ensure lotb_opportunities
ensure lotb_archive
ensure lotb_hud
